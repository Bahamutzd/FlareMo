# Vite's build output under /assets/ is content-hashed: a changed file gets a
# new name, so browsers may keep each one for a year without revalidating.
# Workers Assets serves these before the Worker runs, so the header has to be
# set here rather than in the Worker. index.html, sw.js and the other public
# files keep the default revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

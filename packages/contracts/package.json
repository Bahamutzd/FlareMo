{
  "name": "@flaremo/contracts",
  "license": "AGPL-3.0-only",
  "version": "0.20.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./search-query": {
      "types": "./src/search-query.ts",
      "default": "./src/search-query.ts"
    },
    "./capture": {
      "types": "./src/capture.ts",
      "default": "./src/capture.ts"
    },
    "./capture-limits": {
      "types": "./src/capture-limits.ts",
      "default": "./src/capture-limits.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
